{
  "name": "@quantlix/anycode-client",
  "version": "0.1.0-preview.1",
  "description": "TypeScript client for the AnyCode service contract",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
