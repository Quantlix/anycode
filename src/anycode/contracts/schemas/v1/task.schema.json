{
  "$defs": {
    "ContractError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ContractError",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "allow_partial_dependency_artifacts": {
      "default": false,
      "title": "Allow Partial Dependency Artifacts",
      "type": "boolean"
    },
    "attempt": {
      "default": 1,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "causation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dependencies": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Dependencies",
      "type": "array"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContractError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "generation": {
      "default": 1,
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "produced_artifact_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Produced Artifact Ids",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "default": "accepted",
      "enum": [
        "accepted",
        "queued",
        "running",
        "waiting",
        "succeeded",
        "failed",
        "canceled",
        "rejected"
      ],
      "title": "State",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "waiting_reason": {
      "anyOf": [
        {
          "enum": [
            "dependency",
            "schedule",
            "input_required",
            "authorization_required",
            "approval_required",
            "retry_backoff",
            "capacity",
            "external_signal"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Waiting Reason"
    }
  },
  "required": [
    "id",
    "run_id",
    "title",
    "correlation_id"
  ],
  "title": "Task",
  "type": "object"
}
