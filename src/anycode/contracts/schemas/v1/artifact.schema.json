{
  "$defs": {
    "ArtifactProvenance": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "operation_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Key"
        },
        "producer": {
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "source_artifact_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Artifact Ids",
          "type": "array"
        }
      },
      "required": [
        "producer"
      ],
      "title": "ArtifactProvenance",
      "type": "object"
    },
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "form": {
          "const": "reference",
          "default": "reference",
          "title": "Form",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "provider"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "ArtifactRetention": {
      "additionalProperties": false,
      "properties": {
        "legal_hold": {
          "default": false,
          "title": "Legal Hold",
          "type": "boolean"
        },
        "policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy"
        },
        "retain_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retain Until"
        }
      },
      "title": "ArtifactRetention",
      "type": "object"
    },
    "InlineArtifactContent": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "title": "Data",
          "type": "string"
        },
        "encoding": {
          "default": "base64",
          "enum": [
            "utf-8",
            "base64"
          ],
          "title": "Encoding",
          "type": "string"
        },
        "form": {
          "const": "inline",
          "default": "inline",
          "title": "Form",
          "type": "string"
        }
      },
      "required": [
        "data"
      ],
      "title": "InlineArtifactContent",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "default": 1,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "causation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "classification": {
      "default": "internal",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "Classification",
      "type": "string"
    },
    "content": {
      "discriminator": {
        "mapping": {
          "inline": "#/$defs/InlineArtifactContent",
          "reference": "#/$defs/ArtifactReference"
        },
        "propertyName": "form"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/InlineArtifactContent"
        },
        {
          "$ref": "#/$defs/ArtifactReference"
        }
      ],
      "title": "Content"
    },
    "correlation_id": {
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Digest",
      "type": "string"
    },
    "finalized": {
      "default": true,
      "title": "Finalized",
      "type": "boolean"
    },
    "generation": {
      "default": 1,
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "media_type": {
      "minLength": 1,
      "title": "Media Type",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/ArtifactProvenance"
    },
    "retention": {
      "$ref": "#/$defs/ArtifactRetention"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "size": {
      "minimum": 0,
      "title": "Size",
      "type": "integer"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    }
  },
  "required": [
    "id",
    "run_id",
    "name",
    "media_type",
    "size",
    "digest",
    "content",
    "provenance",
    "correlation_id"
  ],
  "title": "Artifact",
  "type": "object"
}
